{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LearnHub;Trusted_Connection=True;Encrypt=False",
    "HangfireConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LearnHubJobs;Trusted_Connection=True;Encrypt=False"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/LearnHub_Api/LearnHub_Api-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "ApplicationName": "LearnHub_Api" }

  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "LearnHubApp",
    "Audience": "learnHubUsers",
    "ExpireMinutes": 30
  },
  "AllowedOrigins": [
    "https://LearnHub.com"
  ],
  "MailSettings": {
    "Mail": "coy.orn23@ethereal.email",
    "DisplayName": "Learn Hub",
    "Password": "",
    "Host": "smtp.ethereal.email",
    "Port": "587"
  }
}
