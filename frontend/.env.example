# Base URL the frontend uses for all API calls.
# Local development (default): leave as /api - the Vite dev server proxies
# this to VITE_DEV_PROXY_TARGET (the backend), stripping the /api prefix.
# This avoids needing to touch the backend's CORS configuration for local dev.
VITE_API_BASE_URL=/api

# Only used by the Vite dev server's proxy (vite.config.ts), never shipped to
# the browser bundle. Point this at your local backend's HTTP profile.
VITE_DEV_PROXY_TARGET=http://localhost:5242

# --- Production example (do not use for local dev) ---
# When deploying, point VITE_API_BASE_URL directly at the real API and make
# sure that API's CORS AllowedOrigins includes this frontend's deployed origin.
# VITE_API_BASE_URL=https://api.learnhub.example.com
